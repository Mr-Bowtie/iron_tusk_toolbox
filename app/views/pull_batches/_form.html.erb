<%= form_with(model: pull_batch, class: "box") do |form| %>
  <% if pull_batch.errors.any? %>
    <div class="notification is-danger">
      <h2 class="title is-6">
        <%= pluralize(pull_batch.errors.count, "error") %> prohibited this pull_batch from being saved:
      </h2>

      <ul>
        <% pull_batch.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <div class="control">
      <%= form.submit class: "button is-primary" %>
    </div>
  </div>
<% end %>
