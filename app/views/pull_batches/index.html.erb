<% if notice.present? %>
  <div class="notification is-success">
    <%= notice %>
  </div>
<% end %>

<% content_for :title, "Pull Batches" %>

<div class="level">
  <div class="level-left">
    <h1 class="title is-1">Pull Batches</h1>
  </div>
  <div class="level-right">
    <%= link_to "New Pull Batch", new_pull_batch_path, class: "button is-primary" %>
  </div>
</div>

<div class="columns is-multiline" id="pull_batches">
  <% @pull_batches.each do |pull_batch| %>
    <div class="column is-one-third">
      <%= render pull_batch, show_actions: true %>
    </div>
  <% end %>
</div>
