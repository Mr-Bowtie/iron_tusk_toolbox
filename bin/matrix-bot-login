#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "net/http"
require "shellwords"
require "uri"

APP_ROOT = File.expand_path("..", __dir__)
ENV_PATH = File.join(APP_ROOT, ".env")
SERVICE_NAME = ENV.fetch("MATRIX_APP_SERVICE", "iron_tusk_toolbox")
DEVICE_ID = ENV.fetch("MATRIX_ALERT_DEVICE_ID", "iron_tusk_alerts")
DEVICE_NAME = ENV.fetch("MATRIX_ALERT_DEVICE_NAME", "Iron Tusk Matrix Alerts")

class EnvFile
  attr_reader :path

  def initialize(path)
    @path = path
    @lines = File.exist?(path) ? File.readlines(path, chomp: true) : []
  end

  def [](key)
    line = @lines.reverse.find { |candidate| candidate.match?(/^\s*#{Regexp.escape(key)}\s*=/) }
    return nil unless line

    value = line.split("=", 2).last.to_s.strip
    unquote(value)
  end

  def merge_into_env!
    @lines.each do |line|
      next if line.strip.empty? || line.strip.start_with?("#")
      next unless line.include?("=")

      key, value = line.split("=", 2)
      key = key.strip
      ENV[key] = unquote(value.strip) unless ENV.key?(key)
    end
  end

  def update!(values)
    values.each do |key, value|
      serialized = "#{key}=#{quote(value)}"
      index = @lines.index { |line| line.match?(/^\s*#{Regexp.escape(key)}\s*=/) }

      if index
        @lines[index] = serialized
      else
        @lines << serialized
      end
    end

    File.write(path, @lines.join("\n") + "\n")
  end

  private

  def unquote(value)
    return value[1...-1] if value.length >= 2 && value.start_with?('"') && value.end_with?('"')
    return value[1...-1] if value.length >= 2 && value.start_with?("'") && value.end_with?("'")

    value
  end

  def quote(value)
    value.to_s.inspect
  end
end

def require_env(key)
  value = ENV.fetch(key, "").strip
  abort "Missing required #{key}. Add it to #{ENV_PATH} or export it before running this command." if value.empty?

  value
end

def post_login(server_url:, username:, password:)
  uri = URI.join(server_url, "/_matrix/client/v3/login")
  request = Net::HTTP::Post.new(uri)
  request["Content-Type"] = "application/json"
  request.body = JSON.generate(
    type: "m.login.password",
    identifier: {
      type: "m.id.user",
      user: username
    },
    password: password,
    device_id: DEVICE_ID,
    initial_device_display_name: DEVICE_NAME,
    refresh_token: true
  )

  response = Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == "https") do |http|
    http.request(request)
  end

  body = JSON.parse(response.body)
  return body if response.is_a?(Net::HTTPSuccess)

  abort "Matrix login failed: HTTP #{response.code} #{body.fetch("errcode", "")} #{body.fetch("error", response.body)}"
rescue JSON::ParserError
  abort "Matrix login returned non-JSON response: #{response&.body}"
end

def restart_app
  if system("docker compose ps #{Shellwords.escape(SERVICE_NAME)} --status running --quiet > /dev/null 2>&1")
    puts "Restarting Docker Compose service #{SERVICE_NAME}..."
    system("docker compose restart #{Shellwords.escape(SERVICE_NAME)}", exception: true)
  else
    puts "Docker Compose service #{SERVICE_NAME} is not running; touching tmp/restart.txt instead..."
    system("bin/rails restart", exception: true)
  end
end

Dir.chdir(APP_ROOT) do
  env_file = EnvFile.new(ENV_PATH)
  env_file.merge_into_env!

  server_url = require_env("MATRIX_SERVER_URL")
  username = require_env("MATRIX_BOT_USERNAME")
  password = require_env("MATRIX_BOT_PASSWORD")

  puts "Logging Matrix bot #{username} into #{server_url} with device_id=#{DEVICE_ID}..."
  login = post_login(server_url: server_url, username: username, password: password)

  access_token = login.fetch("access_token")
  refresh_token = login.fetch("refresh_token")
  expires_in_ms = login["expires_in_ms"]

  env_file.update!(
    "MATRIX_ALERT_ACCESS_TOKEN" => access_token,
    "MATRIX_ALERT_REFRESH_TOKEN" => refresh_token,
    "MATRIX_ALERT_EXPIRES_IN_MS" => expires_in_ms,
    "MATRIX_ALERT_DEVICE_ID" => login.fetch("device_id", DEVICE_ID)
  )

  puts "Updated #{ENV_PATH} with new Matrix alert tokens."
  restart_app
  puts "Done. Do not log out the Matrix device #{login.fetch("device_id", DEVICE_ID)}; that revokes these tokens."
end
